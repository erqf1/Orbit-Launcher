{
  "name": "orbit-launcher",
  "version": "0.1.0",
  "description": "Custom Minecraft launcher",
  "main": "./out/main/index.js",
  "private": true,
  "author": "",
  "homepage": "https://orbit-launcher.invalid",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:win": "npm run build && node -e \"require('child_process').execSync('electron-builder --win', {stdio:'inherit', env:{...process.env, ELECTRON_BUILDER_CACHE: require('path').resolve('.eb-cache')}})\"",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win-portable": "npm run build && node -e \"require('child_process').execSync('electron-builder --win zip --x64', {stdio:'inherit', env:{...process.env, ELECTRON_BUILDER_CACHE: require('path').resolve('.eb-cache')}})\"",
    "dist:linux-portable": "npm run build && electron-builder --linux tar.gz"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "graceful-fs": "^4.2.11",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "prismarine-nbt": "^2.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/graceful-fs": "^4.1.9",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron@44.2.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "qs": "^6.16.0",
    "tough-cookie": "^6.0.2",
    "form-data": "^4.0.6",
    "adm-zip": "^0.6.0"
  }
}
